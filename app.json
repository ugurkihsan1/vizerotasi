{
  "expo": {
    "name": "Vize Rotası",
    "slug": "vizerotasi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vizerotasi.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vizerotasi.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "vizerotasi",
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafını seçebilmen için fotoğraflarına erişim gerekiyor.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
